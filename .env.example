# App
NEXT_PUBLIC_APP_NAME=Placard
NEXT_PUBLIC_APP_DOMAIN=localhost:3000        # production: your vercel.app address, e.g. placard.vercel.app (Step 7)
NEXT_PUBLIC_APP_URL=http://localhost:3000    # production: https://placard.vercel.app
NEXT_PUBLIC_SITE_PATHS=false                 # true in production on a vercel.app address: portfolios at /p/{slug} (Step 7)
APP_ENV=dev                                   # dev | prod (sent as the `environment` property)

# Neon: `npx neon env pull` fills these from the linked branch (`dev` on your machine). Never paste them by hand.
# Postgres (Step 1): DATABASE_URL pooled (the app), DATABASE_URL_UNPOOLED direct (drizzle-kit)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# AI Gateway (Step 4)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Realtime (Step 9)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Object Storage (Step 10)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Clerk (Step 1; webhook secret from Step 7, plan ID from Step 8)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_PRO_PLAN_ID=

# PostHog, EU cloud (Step 1; survey ID from Step 12)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_SURVEY_ID=

